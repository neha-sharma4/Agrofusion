# SQLite (no Docker / PostgreSQL required)
DATABASE_URL="file:./dev.db"

# JWT (use long random strings in your real .env)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed: username = ADMIN_EMAIL. Password is generated by `npm run seed:admin`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Gemini (vision-capable). Put your real key only in .env, never here.
# Both GEMINI_* and LLM_* aliases are supported by the backend.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# LLM_API_KEY="your-gemini-api-key"
# LLM_MODEL="gemini-2.5-flash"
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
LLM_TEMPERATURE=0.25

# Disease confidence (backend-enforced)
DISEASE_CONFIDENCE_THRESHOLD=0.70

# Weather (OpenWeatherMap-compatible). Put your real key only in .env.
WEATHER_API_KEY="your-weather-api-key"
WEATHER_API_BASE_URL="https://api.openweathermap.org/data/2.5"

# Email / OTP (optional in development — OTP is logged if SMTP is unset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AgroFusion AI <noreply@example.com>"

# App URLs
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Image storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
